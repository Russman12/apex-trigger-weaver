<?xml version="1.0" encoding="UTF-8" ?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description
  >Access to the Trigger Weaver tab, which orders and creates actions. Saving changes deploys metadata, so users also need the Customize Application permission.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>Trigger Weaver Action Manager</label>
    <classAccesses>
        <apexClass>TW_ActionManagerController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>TW_Action_Deployment__e</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <tabSettings>
        <tab>TW_Action_Manager</tab>
        <visibility>Visible</visibility>
    </tabSettings>
</PermissionSet>
